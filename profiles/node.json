{
  "name": "node",
  "commands": {
    "test": { "argv": ["node", "--test", "--test-reporter=tap"], "parse": "tap", "timeoutMs": 300000 }
  },
  "bashAllow": ["node --test"],
  "sourceGlobs": ["**/*.mjs", "**/*.js", "**/*.cjs"],
  "testGlobs": ["test/**", "tests/**", "**/*.test.mjs", "**/*.test.js"]
}
